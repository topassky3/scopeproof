# Copy values into your terminal environment; this file is never loaded automatically.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-local-random-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set after forge register; never use the all-zero placeholder.
SCOPEPROOF_FORGE_APP_ID=ari:cloud:ecosystem::app/REPLACE_ME
# Production only:
# SCOPEPROOF_DB_ENGINE=postgres
# POSTGRES_DB=scopeproof
# POSTGRES_USER=scopeproof
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Development signup and standalone API. Production default: disabled.
# SCOPEPROOF_STANDALONE_AUTH=1
# SCOPEPROOF_ALLOW_SIGNUP=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-host.example
